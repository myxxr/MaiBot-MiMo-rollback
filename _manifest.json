{
  "manifest_version": 2,
  "id": "myxxr.mimo-rollback",
  "version": "1.0.0",
  "name": "MaiBot-MiMo-rollback",
  "description": "接入小米 MiMo 的 OpenAI 兼容接口；当 MiMo 把 high risk 拦截文本当作正常回答返回时，把它识别为错误并交由主程序重试 / 切换模型，避免该文本被直接发给用户",
  "author": {
    "name": "myxxr",
    "url": "https://github.com/myxxr"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/myxxr/MaiBot-MiMo-rollback",
    "homepage": "https://github.com/myxxr/MaiBot-MiMo-rollback",
    "documentation": "https://github.com/myxxr/MaiBot-MiMo-rollback",
    "issues": "https://github.com/myxxr/MaiBot-MiMo-rollback/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.24"
    }
  ],
  "llm_providers": [
    {
      "client_type": "mimo.provider",
      "name": "Xiaomi MiMo Provider",
      "description": "小米 MiMo OpenAI 兼容接口，带 high risk 拦截识别",
      "version": "1.0.0"
    }
  ],
  "capabilities": [
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
